# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and BACK IT UP. Without it, every treatment note and health
# record in the database is permanently unreadable.
DATA_ENCRYPTION_KEY=

# Where the SQLite database file lives. Needs to be on a persistent disk.
DATABASE_PATH=./data/practice.db
