# ─── Required ────────────────────────────────────────────────────────────────

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and BACK IT UP. Without it, every treatment note and health
# record in the database is permanently unreadable.
DATA_ENCRYPTION_KEY=

# Where the SQLite database lives. Must be on a persistent disk.
DATABASE_PATH=./data/practice.db


# ─── Automatic nightly backup ────────────────────────────────────────────────

# The passphrase the nightly backup is encrypted with. Must be 12+ characters.
# Without it, no automatic backup is taken — it will never write an unencrypted
# copy of client health records to disk as a fallback.
# WRITE THIS DOWN SOMEWHERE PHYSICAL. Nobody can open the backups without it.
BACKUP_PASSPHRASE=

BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30
# When the nightly backup runs (cron, in the practice's timezone).
BACKUP_CRON=30 2 * * *


# ─── Email: reminders and emailed backups ────────────────────────────────────
# Optional. Everything else works without it; reminders simply don't send.
# Any SMTP provider works — Fastmail, Gmail with an app password, Resend,
# Postmark, or your host's relay.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reminders go out the evening before an appointment.
REMINDER_CRON=0 18 * * *

# Where to email the nightly backup. Leave blank to skip emailing it.
BACKUP_EMAIL_TO=


# ─── OneDrive backup ─────────────────────────────────────────────────────────
# Optional. Run `npm run onedrive-setup` to obtain these — see README.
# Access is limited to the app's own folder, never the rest of the drive.

ONEDRIVE_CLIENT_ID=
ONEDRIVE_REFRESH_TOKEN=


# ─── Other ───────────────────────────────────────────────────────────────────

# Sign out after this many minutes of inactivity.
IDLE_TIMEOUT_MINUTES=20

# Set to 1 to stop the background jobs (useful in development).
DISABLE_SCHEDULER=

# Set to 1 only once the placeholder content has been replaced with real
# details. Until then the site asks search engines not to index it.
NEXT_PUBLIC_ALLOW_INDEXING=
