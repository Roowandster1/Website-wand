# Copy to .env and fill in.  .env is gitignored — never commit real values.

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then message your bot once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic (for the /update summariser, Phase 4) ------------------------
ANTHROPIC_API_KEY=

# --- Frigate ----------------------------------------------------------------
# Timezone for recording timestamps and the activity ledger.
TZ=Europe/London

# Host path where Frigate writes recordings. Needs real disk space —
# budget ~10GB/day at 1024x576. Keep this OFF the SD card on a Pi.
FRIGATE_MEDIA=./frigate/media
